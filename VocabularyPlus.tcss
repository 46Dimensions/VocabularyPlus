$accent: #8133EF
#logo {
    margin: 1 0 1 1;
}

Label {
    margin-left: 1;
}

Static {
    margin-left: 1;
}

OptionMenu {
    margin: 1 1 0 0;
}

.title {
    text-style: bold underline;
}

Button {
    margin-left: 1
}

#navbar {
    dock: bottom;
    height: 3;
}

#navbar Button {
    width: 1fr;
    margin-left: 0;
}

.selected {
    background: $accent;
}

#dialog {
    background: $surface;
}

ModalScreen {
    align: center middle;
    background: $background 10%;
}

ModalScreen Button {
    margin: 1 0 0 1;
}

#filepicker {
    width: 60%;
    height: 70%;
    align: center middle;
    background: $background;
    border: round $accent;
    padding: 1 2;
}

#filepicker-list {
    height: auto;
    max-height: 15;
    padding: 1 1 1 1;
}

#save-quiz-screen {
    width: 60%;
    height: 70%;
    align: center middle;
    background: $background;
    border: round $accent;
    padding: 1 2;
}

#table {
    height: 60%;
    border: solid $primary;
}

VocabularyRow {
    layout: horizontal;
    width: 100%;
    height: 3;
}

VocabularyRow Input {
    width: 1fr;
}

VocabularyRow .delete {
    width: 5;
    min-width: 5;
}

#add {
    background: green;
    width: 50%;
    height: 3;
    min-height: 2;
    border: none;
}

#add:hover {
    background: darkgreen;
}

#close {
    background: orange;
    width: 50%;
    height: 3;
    min-height: 2;
    border: none;
}

#close:hover {
    background: darkorange;
}

#languages-row {
    text-style: bold;
}

.green {
    background: green;
}

.green:hover {
    background: darkgreen;
}

.orange {
    background: orange;
}

.orange:hover {
    background: darkorange;
}

.red {
    background: red;
}

.red:hover {
    background: darkred;
}

.green Button, .orange Button, .red Button {
    border: none;
}

#save-file-screen-buttons Button {
    border: none;
    height: 3;
    width: 33%
}

#save-file-screen {
    width: 60%;
    height: 60%;
    align: center middle;
    border: round $accent;
    background: $background;
}